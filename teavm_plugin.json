    "html": "<html><head>\n  <meta charset=\"utf-8\">\n  <title>Gradle - Plugin: org.teavm</title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <link rel=\"stylesheet\" href=\"//fonts.googleapis.com/css?family=Lato:400,700\" type=\"text/css\">\n  <link rel=\"stylesheet\" href=\"https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css\" integrity=\"sha384-HSMxcRTRxnN+Bdg0JdbxYKrThecOKuH5zCYotlSAcp1+c8xmyTe9GYg1l9a69psu\" crossorigin=\"anonymous\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"/shared-assets/shared/styles/8119833b0ba7a8daac25b9f30683fdef-main.css\">\n  <link rel=\"shortcut icon\" href=\"/shared-assets/shared/images/31b6e3c2756b1d0d9a4438e79f304707-elephant.ico\">\n  <script src=\"https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js\" integrity=\"sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs\" crossorigin=\"anonymous\"></script>\n  <script src=\"https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js\" integrity=\"sha384-aJ21OjlMXNL5UyIl/XNwTMqvzeRMZH2w8c5cRVpzpU8Y5bApTppSuUkhZXN0VxHd\" crossorigin=\"anonymous\"></script>\n  \n  <script src=\"/shared-assets/shared/scripts/026008a6e35531db469e623662c4a07f-prism.js\"></script>\n  \n\n</head>\n<body>\n  <div id=\"content-wrapper\">\n    <header>\n        <nav class=\"navbar navbar-default\">\n            <div class=\"container\">\n                <div class=\"navbar-header\">\n                    <button type=\"button\" class=\"navbar-toggle collapsed\" data-toggle=\"collapse\" data-target=\"#navbar-collapse\">\n                        <span class=\"sr-only\">Toggle navigation</span>\n                        <span class=\"icon-bar\"></span>\n                        <span class=\"icon-bar\"></span>\n                        <span class=\"icon-bar\"></span>\n                    </button>\n                    <a class=\"navbar-brand\" href=\"https://gradle.org/\">\n                        <img src=\"/shared-assets/shared/images/e9c873fb72458b7263b520dc6e3c9a7d-elephant-corner.png\" width=\"32px\" height=\"32px\">\n                    </a>\n                </div>\n\n                <div class=\"collapse navbar-collapse\" id=\"navbar-collapse\">\n                    <ul class=\"nav navbar-nav\">\n                        <li>\n                          <a href=\"/\">Plugins</a>\n                        </li>\n                        <li class=\"dropdown\" id=\"documentation-dropdown\">\n                            <a href=\"#\" class=\"dropdown-toggle\" data-toggle=\"dropdown\" role=\"button\" aria-expanded=\"false\">Documentation <span class=\"caret\"></span></a>\n                            <ul class=\"dropdown-menu\" role=\"menu\">\n                                <li id=\"submit-documentation-link\">\n                                  <a href=\"/docs/publish-plugin\">\n                                        Publish a plugin\n                                    </a>\n                                </li>\n                                <li id=\"deleting-documentation-link\">\n                                  <a href=\"/docs/deleting\">\n                                        Delete a plugin\n                                    </a>\n                                </li>\n                                <li id=\"mirroring-documentation-link\">\n                                  <a href=\"/docs/mirroring\">\n                                        Mirror the plugin portal\n                                    </a>\n                                </li>\n                                <li id=\"further-help-link\">\n                                  <a href=\"/docs/get-help\">\n                                    Get further help\n                                  </a>\n                                </li>\n                            </ul>\n                        </li>\n                        \n                          <li id=\"forums-link\">\n                            <a href=\"https://discuss.gradle.org\" target=\"_blank\">Forums</a>\n                          </li>\n                        \n                    </ul>\n                    <ul class=\"nav navbar-nav navbar-right\">\n                    \n                            <li>\n                                <a id=\"login-action\" href=\"/user/login?returnTo=%2Fplugin%2Forg.teavm\" data-toggle=\"tooltip\" data-placement=\"bottom\" title=\"Log in\">\n                                    &nbsp;&nbsp;&nbsp;&nbsp;\n                                    <span class=\"glyphicon glyphicon-log-in\" aria-hidden=\"true\">\n                                    </span>\n                                </a>\n                            </li>\n                        \n                    </ul>\n                </div>\n            </div>\n        </nav>\n    </header>\n    \n\n\n\n\n\n\n\n\n\n\n\n\n    \n    <div id=\"content\">\n      \n<div class=\"container plugin-page\">\n  <div class=\"clearfix\">\n    <div class=\"row top-row\">\n      <div class=\"col-md-3 logo-wrapper\">\n        \n<div class=\"logo\">\n  <a href=\"/\">\n      <img src=\"/shared-assets/shared/images/f4096eb5ec6e31f39ef31ec97e93e064-gradle-logo-horizontal.svg\" height=\"55.890410958904106px\" width=\"160.0px\" alt=\"Gradle Logo\">\n  </a>\n</div>\n\n\n      </div>\n\n            <div class=\"col-md-4 col-md-offset-5\">\n                <p>Search Gradle plugins</p>\n\n                <form id=\"search\" action=\"/search\">\n                    <div class=\"form-group\">\n                        <input class=\"form-control\" type=\"text\" name=\"term\" id=\"term\" placeholder=\"search by tag or keyword\">\n                    </div>\n                </form>\n            </div>\n        </div>\n    </div>\n\n  <div class=\"modal fade\" id=\"confirmation-modal-update\" tabindex=\"-1\" role=\"dialog\">\n    <div class=\"modal-dialog\" role=\"document\">\n      <div class=\"modal-content\">\n        <div class=\"modal-header\">\n          <h4 class=\"modal-title\">Plugin edit confirmation</h4>\n          <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\">\n            <span aria-hidden=\"true\">×</span>\n          </button>\n        </div>\n        <div class=\"modal-body\">\n          <span id=\"description-modal-update-body\" style=\"white-space: pre-wrap\"></span>\n        </div>\n        <div class=\"modal-footer\">\n          <button id=\"description-update-cancellation\" type=\"button\" class=\"btn btn-secondary\" data-dismiss=\"modal\">\n            Cancel\n          </button>\n          <button id=\"description-update-confirmation\" type=\"button\" class=\"btn btn-primary\" data-dismiss=\"modal\">\n            Update\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"modal fade\" id=\"confirmation-delete-plugin\" tabindex=\"-1\" role=\"dialog\">\n    <div class=\"modal-dialog\" role=\"document\">\n      <div class=\"modal-content\">\n        <div class=\"modal-header\">\n          <h4 class=\"modal-title\">Delete plugin confirmation</h4>\n          <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\">\n            <span aria-hidden=\"true\">×</span>\n          </button>\n        </div>\n        <div class=\"modal-header\">\n          To confirm the plugin deletion insert pluginId and author name\n        </div>\n        <p id=\"pluginAuthorValue\" style=\"display:none\">Aleksei Andreev</p>\n        <p id=\"pluginIdValue\" style=\"display:none\">org.teavm</p>\n        <div class=\"modal-body\">\n          PluginId <input id=\"delete-plugin-id-conf\" style=\"white-space: pre-wrap\">\n        </div>\n        <div class=\"modal-body\">\n          Author <input id=\"delete-plugin-author-conf\" style=\"white-space: pre-wrap\">\n        </div>\n        <div id=\"delete-plugin-error\" class=\"modal-body\" style=\"display:none\">\n          <span style=\"white-space: pre-wrap\" id=\"confirm-error-message\"></span>\n        </div>\n        <div class=\"modal-footer\">\n          <button id=\"delete-plugin-dismiss\" type=\"button\" class=\"btn btn-secondary\" data-dismiss=\"modal\">\n            Dismiss\n          </button>\n          <button id=\"delete-plugin-confirmation\" type=\"button\" class=\"btn btn-primary\">\n            Confirm\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n    <div class=\"row plugin-detail box\">\n        <div class=\"detail plugin-info\">\n          <div class=\"text-right\" style=\"margin-top: 20px;float: right;\">\n            <a class=\"report-plugin-description btn btn-sm\" target=\"_blank\" href=\"https://github.com/gradle/plugin-portal-requests/issues/new?template=50_plugin_description.yml&amp;title=Incorrect+plugin+description+for+org.teavm&amp;plugin-id=https://plugins.gradle.org/plugin/org.teavm&amp;version=0.15.0+(latest)\">\n              <span class=\"glyphicon glyphicon-flag\"></span>\n              Report incorrect plugin description\n            </a>\n          </div>\n          <div class=\"plugin-header\">\n            <a href=\"/plugin/org.teavm\">\n              <h1 id=\"plugin-id\" style=\"margin-right:10px;\">org.teavm</h1>\n            </a>\n            <div class=\"badges\">\n              \n            </div>\n          </div>\n          \n            <div class=\"plugin-owner\">\n              <p>\n                <strong>Owner:</strong>\n                <a id=\"plugin-owner-link\" href=\"/u/konsoletyper\">\n                  <img src=\"https://www.gravatar.com/avatar/f8a2b866ae0dc92a9e774d0094da8f4d?s=230&amp;d=identicon\" class=\"owner-avatar img-rounded\">\n                  Aleksei Andreev\n                </a>\n              </p>\n            </div>\n          \n          <div id=\"plugin-details\">\n            <div class=\"plugin-info\">\n              <p id=\"plugin-description\" class=\"description-text\" style=\"white-space: pre-wrap\">Installs TeaVM compilation tasks, configurations and source sets</p>\n            </div>\n            \n              <p class=\"website\"><a id=\"website\" href=\"https://teavm.org\">https://teavm.org</a></p>\n            \n            \n              <p class=\"vcs\">Sources:\n                <a id=\"vcsUrl\" href=\"https://github.com/konsoletyper/teavm\">https://github.com/konsoletyper/teavm</a>\n              </p>\n            \n            \n            <div class=\"plugin-about\">\n              <ul class=\"list-inline\">\n                \n                  <li>\n                    <a class=\"plugin-tag\" href=\"/search?term=teavm\">#teavm</a>\n                  </li>\n                \n                  <li>\n                    <a class=\"plugin-tag\" href=\"/search?term=javascript\">#javascript</a>\n                  </li>\n                \n                  <li>\n                    <a class=\"plugin-tag\" href=\"/search?term=webassembly\">#webassembly</a>\n                  </li>\n                \n                  <li>\n                    <a class=\"plugin-tag\" href=\"/search?term=compiler\">#compiler</a>\n                  </li>\n                \n                  <li>\n                    <a class=\"plugin-tag\" href=\"/search?term=aot-compiler\">#aot-compiler</a>\n                  </li>\n                \n              </ul>\n            </div>\n          </div>\n\n          \n\n        <div class=\"version-info well well-sm\">\n            <h3>Version 0.15.0  (latest) </h3>\n            <p id=\"plugin-id-version\" style=\"display:none;\">0.15.0</p>\n            <p class=\"version-created-date\">\n                Created 14 June 2026.\n            </p>\n            <p class=\"version-description\">\n                <span id=\"plugin-version-description\" class=\"description-text\" style=\"white-space: pre-wrap\">Installs TeaVM compilation tasks, configurations and source sets</span>\n            </p>\n            \n            \n            \n                <div class=\"other-versions dropdown\">\n                    <a class=\"dropdown-toggle\" type=\"button\" data-toggle=\"dropdown\">Other versions&nbsp;<span class=\"caret\"></span></a>\n                    <ul class=\"dropdown-menu\">\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.14.1\">0.14.1</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.14.0\">0.14.0</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.13.1\">0.13.1</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.13.0\">0.13.0</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.12.3\">0.12.3</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.12.2\">0.12.2</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.12.0\">0.12.0</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.11.0\">0.11.0</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.10.2\">0.10.2</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.10.1\">0.10.1</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.10.0\">0.10.0</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.9.2\">0.9.2</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.9.1\">0.9.1</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.9.0\">0.9.0</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.8.1\">0.8.1</a>\n                          </li>\n                        \n                          <li>\n                            <a href=\"/plugin/org.teavm/0.8.0\">0.8.0</a>\n                          </li>\n                        \n                    </ul>\n                </div>\n            \n\n            \n        </div>\n        \n            <div>\n              <p>Add this plugin to your build using the <a href=\"https://docs.gradle.org/current/userguide/plugins.html#sec:plugins_block\">plugins DSL</a>:</p>\n              <pre class=\"language-gradle\" tabindex=\"0\"><code class=\"language-gradle\"><span class=\"token keyword\">plugins</span> <span class=\"token punctuation\">{</span>\n  <span class=\"token function\">id</span><span class=\"token punctuation\">(</span><span class=\"token interpolation-string\"><span class=\"token string\">\"org.teavm\"</span></span><span class=\"token punctuation\">)</span> version <span class=\"token interpolation-string\"><span class=\"token string\">\"0.15.0\"</span></span>\n<span class=\"token punctuation\">}</span></code></pre>\n\n              <p>See also:</p>\n              <ul>\n              <li>\n                <details>\n                  <summary class=\"with-hint\">Adding the plugin to build logic for usage in precompiled script plugins.</summary>\n                  <p><span>See the relevant <a href=\"https://docs.gradle.org/current/userguide/implementing_gradle_plugins_precompiled.html#sec:applying_external_plugins\">documentation</a> for more information.</span></p>\n                  <p>Add this plugin as a dependency to <code>&lt;convention-plugins-build&gt;/build.gradle(.kts)</code>:</p>\n                  <pre class=\"language-gradle\" tabindex=\"0\"><code class=\"language-gradle\"><span class=\"token keyword\">dependencies</span> <span class=\"token punctuation\">{</span>\n  <span class=\"token keyword\">implementation</span><span class=\"token punctuation\">(</span><span class=\"token interpolation-string\"><span class=\"token string\">\"org.teavm:org.teavm.gradle.plugin:0.15.0\"</span></span><span class=\"token punctuation\">)</span>\n<span class=\"token punctuation\">}</span></code></pre>\n                  <div>It can then be applied in the precompiled script plugin:</div>\n                  <pre class=\"language-gradle\" tabindex=\"0\"><code class=\"language-gradle\"><span class=\"token keyword\">plugins</span> <span class=\"token punctuation\">{</span>\n  <span class=\"token function\">id</span><span class=\"token punctuation\">(</span><span class=\"token interpolation-string\"><span class=\"token string\">\"org.teavm\"</span></span><span class=\"token punctuation\">)</span>\n<span class=\"token punctuation\">}</span></code></pre>\n                </details>\n              </li>\n              <li>\n                <details>\n                <summary class=\"with-hint\">The legacy method of plugin application.</summary>\n                  <span>See the relevant <a href=\"https://docs.gradle.org/current/userguide/plugins.html#sec:applying_plugins_buildscript\">documentation</a> for more information.</span>\n                <pre class=\"language-gradle\" tabindex=\"0\"><code class=\"language-gradle\">buildscript <span class=\"token punctuation\">{</span>\n  <span class=\"token keyword\">repositories</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token function\">gradlePluginPortal</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span>\n  <span class=\"token punctuation\">}</span>\n  <span class=\"token keyword\">dependencies</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token function\">classpath</span><span class=\"token punctuation\">(</span><span class=\"token interpolation-string\"><span class=\"token string\">\"org.teavm:org.teavm.gradle.plugin:0.15.0\"</span></span><span class=\"token punctuation\">)</span>\n  <span class=\"token punctuation\">}</span>\n<span class=\"token punctuation\">}</span>\n\n<span class=\"token keyword\">apply</span><span class=\"token punctuation\">(</span><span class=\"token keyword\">plugin</span> <span class=\"token operator\">=</span> <span class=\"token interpolation-string\"><span class=\"token string\">\"org.teavm\"</span></span><span class=\"token punctuation\">)</span></code></pre>\n                </details>\n              </li>\n              <li>\n                <a href=\"https://docs.gradle.org/current/userguide/plugins.html#sec:subprojects_plugins_dsl\">\n                  Applying plugins to all subprojects\n                </a>.\n              </li>\n              </ul>\n            </div>\n        \n    </div>\n</div>\n\n    </div>\n  </div>\n  <footer>\n    <div class=\"footer-inner\">\n      <div class=\"footer-top\">\n        <a class=\"footer-logo\" href=\"https://gradle.com/\">\n          <img src=\"/shared-assets/shared/images/b409413fbfb34c70133e5efa6d472bbe-gradle-logo-landscape-mono-dark.svg\" alt=\"\">\n        </a>\n        \n<div class=\"terms\">\n  <a href=\"/docs/terms\">Terms of Use</a>\n  <span class=\"terms-sep\">|</span>\n  <a href=\"https://gradle.com/legal/privacy/\">Privacy Policy</a>\n</div>\n\n      </div>\n      <div class=\"footer-copyright\">\n        <p class=\"copyright\">\n              © 2026 <a href=\"https://gradle.com\">\n          Gradle, Inc.</a>\n          Gradle®, Develocity®, Build Scan®, and the Gradlephant logo are registered trademarks of Gradle, Inc.\n          On this resource, \"Gradle\" typically means \"Gradle Build Tool\" and does not reference Gradle, Inc. and/or its subsidiaries.\n        </p>\n      </div>\n    </div>\n  </footer>\n  <script src=\"/shared-assets/shared/scripts/e8bee6f4b1e9d74d56eada0c088ddda0-bootstrap-customizations.js\"></script>\n\n\n\n</div></body></html>",
